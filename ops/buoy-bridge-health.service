[Unit]
Description=OceanPulse Buoy Bridge (Health Circuit)
After=network.target

[Service]
Type=simple
User=router
WorkingDirectory=/home/router/oceanpulse/bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 buoy_bridge.py --circuit H --lora-port /dev/op-lora --mega-port /dev/op-mega
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
