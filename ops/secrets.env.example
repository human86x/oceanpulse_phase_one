# OceanPulse runtime secrets.
#
# Copy this file to `ops/secrets.env` and fill in real values. The real file
# is gitignored and MUST NOT be committed. Loaded by:
#   - obs_center/app.py            (via systemd EnvironmentFile or `set -a; . ops/secrets.env`)
#   - ops/*.sh deploy scripts      (sourced explicitly at top)
#
# On a Pi/VPS this typically lives at /home/lab/oceanpulse/ops/secrets.env
# and is wired into systemd via `EnvironmentFile=` in obs-center.service.

# --- Flask session signing key (any long random string) ---
OP_FLASK_SECRET=change_me_to_a_long_random_string

# --- Obs Center admin login (comma-separated usernames, one shared password) ---
OP_ADMIN_USERS=human,paul
OP_ADMIN_PASS=change_me

# --- FTP relay to public dashboard (oceanpulse.pt) ---
OP_FTP_HOST=ftp.oceanpulse.pt
OP_FTP_USER=oceanpul
OP_FTP_PASS=change_me

# --- SSH password used by deploy scripts to reach Pis (same on all 4) ---
OP_PI_SSH_PASS=change_me

# --- Lab-center sudo password (NetworkManager config script) ---
OP_SUDO_PASS=change_me

# --- Lab WiFi (configure_lab_wifi.sh) ---
OP_LAB_WIFI_SSID=YourSSID
OP_LAB_WIFI_PASS=change_me
